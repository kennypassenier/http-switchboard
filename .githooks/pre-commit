#!/usr/bin/env bash
# Git-native gate (standing rule 19): holds from any session, tool or
# terminal, not only from a Claude Code session. Runs the project's
# gates in the repo the commit actually targets.
set -euo pipefail
root=$(git rev-parse --show-toplevel)
gates="$root/.claude/hooks/gates.sh"
[ -x "$gates" ] || exit 0
if ! (cd "$root" && "$gates"); then
  echo "COMMIT BLOCKED — gates failed (standing rule 7). Fix, then retry." >&2
  exit 1
fi
